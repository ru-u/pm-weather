# Copy to .env (gitignored) and fill in. Names only here, never real values.
# The local .env is never deployed: Railway services get their own variables.

# --- Kalshi trading credentials ---------------------------------------------
# Read ONLY by the future trading service. The logger, discovery, reports and
# every research script use public endpoints and must never load these.
KALSHI_API_KEY_ID=
# Either the PEM text itself (multi-line, quoted) or leave empty and point
# KALSHI_PRIVATE_KEY_PATH at a gitignored .pem file.
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=

# --- ERCOT public API (names that gridstatus reads) --------------------------
# Used only from Railway (US region): ERCOT blocks requests from outside the US.
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=
# Kept for rotation. Nothing reads it.
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY_SECONDARY=

# --- Storage ------------------------------------------------------------------
# Unset = write to ./data locally. On Railway, map these to the bucket's variables.
PMW_DATA_DIR=
PMW_S3_BUCKET=
PMW_S3_ENDPOINT=
PMW_S3_ACCESS_KEY_ID=
PMW_S3_SECRET_ACCESS_KEY=
PMW_S3_REGION=
PMW_S3_PREFIX=

# --- Alerts (optional) ---------------------------------------------------------
# Discord or Slack incoming-webhook URL for logger failure and gap alerts.
PMW_ALERT_WEBHOOK=
